{
    "name": "East River PFCLM",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "8gb",
        "storage": "32gb"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "python -m ipykernel install --user --name subsetting-shortcourse --display-name \"Python (PFCLM)\" && bash scripts/get_forcing.sh",
    "remoteUser": "ubuntu"
}